ativo = false

function menu(){
	
	initial_color = global.white
	initial_border_color = global.bege

	hover_color = global.bege
	hover_border_color = global.white


	color = initial_color 
	border_color = initial_border_color 

	xscale = 8
	yscale = 2
	
	scale_sum = .1
	
	text_x = 0

}

function battle(){
	
	initial_color = global.white
	initial_border_color = global.bege

	hover_color = global.red_l
	hover_border_color = global.white


	color = initial_color 
	border_color = initial_border_color 

	xscale = 6
	yscale = 1.5
	
	scale_sum = .2
	
	text_x = 0

}